              "id": "cond-001",
              "leftValue": "={{ $json['Status'] }}",
              "rightValue": "Wygasła",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "if-001",
      "name": "Ma datę zakończenia?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-002",
              "leftValue": "={{ $json['Data zakończenia'] }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "if-002",
      "name": "Wygasa w ciągu 30 dni?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 200],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-003",
              "leftValue": "={{ Math.ceil((new Date($json['Data zakończenia']).getTime() - Date.now()) / 86400000) }}",
              "rightValue": 30,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            },
            {
              "id": "cond-004",
              "leftValue": "={{ Math.ceil((new Date($json['Data zakończenia']).getTime() - Date.now()) / 86400000) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "if-003",
