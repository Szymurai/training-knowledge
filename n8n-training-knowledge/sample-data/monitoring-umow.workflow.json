      "position": [220, 60],
      "parameters": {
        "content": "## Tryb testowy / produkcyjny\n\nW węźle **⚙️ Konfiguracja** ustaw:\n- `testMode = true` → e-mail trafia na **adres testowy**\n- `testMode = false` → e-mail trafia **do klienta**\n\nTo jedyny punkt konfiguracji środowiska.\nReszta przepływu pozostaje bez zmian.",
        "height": 200,
        "width": 360,
        "color": 4
      }
    },
    {
      "id": "trigger-001",
      "name": "Harmonogram – codziennie 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
