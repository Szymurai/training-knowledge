          "assignments": [
            {
              "id": "assign-001",
              "name": "testMode",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "assign-002",
              "name": "testEmail",
              "value": "test@twojafirma.pl",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
